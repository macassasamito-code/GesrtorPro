# PORT: Porta usada pelo servidor Node.js em produção (Hostinger / Cloud)
PORT=3000

# APP_URL: URL público onde a aplicação está hospedada (ex: https://seudominio.com)
APP_URL="https://seudominio.com"

# GEMINI_API_KEY: Opcional (apenas se activar integrações de IA no servidor)
GEMINI_API_KEY=""

# Opcional: Variáveis Firebase para substituir firebase-applet-config.json por ambiente
# Se deixadas em branco, a aplicação usa automaticamente firebase-applet-config.json
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
