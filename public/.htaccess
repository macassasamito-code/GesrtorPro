<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/javascript .js .mjs
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Servir ficheiros e pastas existentes directamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Redireccionar todas as outras rotas para index.html (SPA React)
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Evitar cache antiga no HTML, Service Worker e Web App Manifest (PWA)
  <FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Cache longa para ficheiros estáticos com hash em /assets/
  <FilesMatch "\.(js|css|png|jpg|jpeg|svg|webp|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
